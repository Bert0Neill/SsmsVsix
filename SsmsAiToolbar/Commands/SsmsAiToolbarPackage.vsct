<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">

	<!-- Required Visual Studio / SSMS headers -->
	<Extern href="stdidcmd.h" />
	<Extern href="vsshlids.h" />

	<Commands package="guidSsmsAiToolbarPackage">

		<!-- ======================== -->
		<!-- GROUPS -->
		<!-- ======================== -->
		<Groups>

			<!-- Add group to SQL Editor context menu -->
			<Group guid="guidEditorContextMenuPackageCmdSet" id="MyEditorGroup" priority="0x0201">
				<Parent guid="queryWindowContextCommandSet" id="queryWindowContextMenus" />
			</Group>

			<!-- Add group to Tools menu -->
			<Group guid="guidSsmsAiToolbarPackageCmdSet" id="MyMenuGroup" priority="0x0600">
				<Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
			</Group>

		</Groups>

		<!-- ======================== -->
		<!-- BUTTONS -->
		<!-- ======================== -->
		<Buttons>

			<!-- SQL Editor right-click -->
			<Button guid="guidEditorContextMenuPackageCmdSet"
					id="cmdidEditorContextMenuCommand"
					priority="0x0001"
					type="Button">
				<Parent guid="guidEditorContextMenuPackageCmdSet" id="MyEditorGroup" />
				<Icon guid="guidImages" id="bmpPic1" />
				<Strings>
					<ButtonText>AI Editor Command</ButtonText>
				</Strings>
			</Button>

			<!-- Tools menu command -->
			<Button guid="guidSsmsAiToolbarPackageCmdSet"
					id="cmdidToolsMenuCmd"
					priority="0x0100"
					type="Button">
				<Parent guid="guidSsmsAiToolbarPackageCmdSet" id="MyMenuGroup" />
				<Icon guid="guidImages1" id="bmpPic1" />
				<Strings>
					<ButtonText>Invoke ToolsMenuCmd</ButtonText>
				</Strings>
			</Button>

		</Buttons>

		<!-- ======================== -->
		<!-- IMAGES -->
		<!-- ======================== -->
		<Bitmaps>
			<Bitmap guid="guidImages"
					href="Resources\EditorContextMenu.png"
					usedList="bmpPic1" />

			<Bitmap guid="guidImages1"
					href="Resources\ToolsMenuCmd.png"
					usedList="bmpPic1" />
		</Bitmaps>

	</Commands>

	<!-- ======================== -->
	<!-- SYMBOLS -->
	<!-- ======================== -->
	<Symbols>

		<!-- Package GUID -->
		<GuidSymbol name="guidSsmsAiToolbarPackage" value="{faba82a2-c872-4238-9d9b-80b03daee65e}" />

		<!-- SQL Editor context menu command set -->
		<GuidSymbol name="guidEditorContextMenuPackageCmdSet" value="{0d082b0f-1fe3-40d2-a95d-a06cad922055}">
			<IDSymbol name="MyEditorGroup" value="0x2000" />
			<IDSymbol name="cmdidEditorContextMenuCommand" value="0x2001" />
		</GuidSymbol>

		<!-- SSMS Query Window GUID -->
		<GuidSymbol name="queryWindowContextCommandSet" value="{33F13AC3-80BB-4ECB-85BC-225435603A5E}">
			<IDSymbol name="queryWindowContextMenus" value="0x0050" />
		</GuidSymbol>

		<!-- Main icon set -->
		<GuidSymbol name="guidImages" value="{b4ad2ec9-74b1-4f45-94e9-6381f694d634}">
			<IDSymbol name="bmpPic1" value="1" />
		</GuidSymbol>

		<!-- Toolbar / Tools menu command set -->
		<GuidSymbol name="guidSsmsAiToolbarPackageCmdSet" value="{fbbb57d4-3561-47b9-a825-7cbe39cf7baf}">
			<IDSymbol name="MyMenuGroup" value="0x1010" />
			<IDSymbol name="cmdidToolsMenuCmd" value="0x1020" />
		</GuidSymbol>

		<!-- Tools menu icon -->
		<GuidSymbol name="guidImages1" value="{dd362278-21a4-4189-9d8f-1f327e82b7d8}">
			<IDSymbol name="bmpPic1" value="1" />
		</GuidSymbol>

	</Symbols>

</CommandTable>
