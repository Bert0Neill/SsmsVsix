<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidSsmsQueryEditorAIPackage">
    <Groups>
      <Group guid="guidSsmsQueryEditorAIPackageCmdSet" id="MyMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS"/>
      </Group>

      <!-- Same pattern as SsmsAiToolbar: group on SSMS query-window context menu (flat buttons merge reliably). -->
      <Group guid="guidSsmsQueryEditorAIPackageCmdSet" id="AIBuddyEditorGroup" priority="0x0201">
        <Parent guid="queryWindowContextCommandSet" id="queryWindowContextMenus"/>
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidSsmsQueryEditorAIPackageCmdSet" id="ConfigureAI_CmdId" priority="0x0100" type="Button">
        <Parent guid="guidSsmsQueryEditorAIPackageCmdSet" id="MyMenuGroup" />
        <Icon guid="guidImages" id="bmpPic1" />
        <Strings>
          <ButtonText>Invoke ConfigureAI_Cmd</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidSsmsQueryEditorAIPackageCmdSet" id="SqlContinuationRulesCmdId" priority="0x0101" type="Button">
        <Parent guid="guidSsmsQueryEditorAIPackageCmdSet" id="AIBuddyEditorGroup"/>
        <Icon guid="guidImages" id="bmpPic1"/>
        <Strings>
          <ButtonText>SQL Continuation Using Rules</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidSsmsQueryEditorAIPackageCmdSet" id="SqlContinuationAiCmdId" priority="0x0102" type="Button">
        <Parent guid="guidSsmsQueryEditorAIPackageCmdSet" id="AIBuddyEditorGroup"/>
        <Icon guid="guidImages" id="bmpPic1"/>
        <Strings>
          <ButtonText>SQL Continuation Using AI</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidSsmsQueryEditorAIPackageCmdSet" id="CorrectSqlErrorsCmdId" priority="0x0103" type="Button">
        <Parent guid="guidSsmsQueryEditorAIPackageCmdSet" id="AIBuddyEditorGroup"/>
        <Icon guid="guidImages" id="bmpPic1"/>
        <Strings>
          <ButtonText>Correct SQL errors</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidSsmsQueryEditorAIPackageCmdSet" id="DisplayPromptCmdId" priority="0x0104" type="Button">
        <Parent guid="guidSsmsQueryEditorAIPackageCmdSet" id="AIBuddyEditorGroup"/>
        <Icon guid="guidImages" id="bmpPic1"/>
        <Strings>
          <ButtonText>Display Prompt</ButtonText>
        </Strings>
      </Button>
    </Buttons>

    <Bitmaps>
      <Bitmap guid="guidImages" href="Resources\ConfigureAI_Cmd.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough"/>
    </Bitmaps>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidSsmsQueryEditorAIPackage" value="{f79b07ee-abe6-4e30-bb4f-c6808f451d62}" />

    <GuidSymbol name="guidSsmsQueryEditorAIPackageCmdSet" value="{d5cfa9e8-a7de-4eb4-b34f-0ab39f9e31a3}">
      <IDSymbol name="MyMenuGroup" value="0x1020" />
      <IDSymbol name="AIBuddyEditorGroup" value="0x1030" />
      <IDSymbol name="ConfigureAI_CmdId" value="0x0100" />
      <IDSymbol name="SqlContinuationRulesCmdId" value="0x0101" />
      <IDSymbol name="SqlContinuationAiCmdId" value="0x0102" />
      <IDSymbol name="CorrectSqlErrorsCmdId" value="0x0103" />
      <IDSymbol name="DisplayPromptCmdId" value="0x0104" />
    </GuidSymbol>

    <GuidSymbol name="queryWindowContextCommandSet" value="{33F13AC3-80BB-4ECB-85BC-225435603A5E}">
      <IDSymbol name="queryWindowContextMenus" value="0x0050" />
    </GuidSymbol>

    <GuidSymbol name="guidImages" value="{d08500d9-d83e-4535-91fd-e8a791ff9561}" >
      <IDSymbol name="bmpPic1" value="1" />
      <IDSymbol name="bmpPic2" value="2" />
      <IDSymbol name="bmpPicSearch" value="3" />
      <IDSymbol name="bmpPicX" value="4" />
      <IDSymbol name="bmpPicArrows" value="5" />
      <IDSymbol name="bmpPicStrikethrough" value="6" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
