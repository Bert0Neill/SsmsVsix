  <!--
    SSMS host assemblies MUST NOT be packaged inside the VSIX.
    If they land next to the extension DLLs, SSMS 19/20 can load the wrong versions from the extension folder
    and the extension breaks (type load failures, missing members, etc.).
  -->
  <Target Name="PreventSsmsHostCopyLocal" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'SqlWorkbench.Interfaces' Or '%(Filename)' == 'SqlPackageBase' Or '%(Filename)' == 'ObjectExplorer'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.SqlServer.'))" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Microsoft.Data.Tools.Sql.BatchParser'" />
    </ItemGroup>
  </Target>
  <Target Name="ExcludeSsmsHostAssembliesFromVsix" AfterTargets="GetVsixSourceItems" BeforeTargets="CreateVsixContainer">
    <ItemGroup>
      <_VsixItemsToDrop Include="@(VSIXSourceItem)" Condition="'%(Filename)' == 'SqlWorkbench.Interfaces' Or '%(Filename)' == 'SqlPackageBase' Or '%(Filename)' == 'ObjectExplorer'" />
      <_VsixItemsToDrop Include="@(VSIXSourceItem)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.SqlServer'))" />
      <_VsixItemsToDrop Include="@(VSIXSourceItem)" Condition="'%(Filename)' == 'Microsoft.Data.Tools.Sql.BatchParser'" />
      <VSIXSourceItem Remove="@(_VsixItemsToDrop)" />
    </ItemGroup>
  </Target>
  <Target Name="ExcludeSsmsHostAssembliesFromVsix" BeforeTargets="GetVsixSourceItems">
    <ItemGroup>
      <!-- SSMS host DLLs -->
      <VSIXSourceItem Remove="$(OutputPath)SqlWorkbench.Interfaces.dll" />
      <VSIXSourceItem Remove="$(OutputPath)SqlPackageBase.dll" />
      <VSIXSourceItem Remove="$(OutputPath)ObjectExplorer.dll" />
      <!-- SMO -->
      <VSIXSourceItem Remove="$(OutputPath)Microsoft.SqlServer.Smo.dll" />
      <VSIXSourceItem Remove="$(OutputPath)Microsoft.SqlServer.SmoExtended.dll" />
      <VSIXSourceItem Remove="$(OutputPath)Microsoft.SqlServer.ConnectionInfo.dll" />
      <VSIXSourceItem Remove="$(OutputPath)Microsoft.SqlServer.Management.Sdk.Sfc.dll" />
      <!-- SQL Parser -->
      <VSIXSourceItem Remove="$(OutputPath)Microsoft.Data.Tools.Sql.BatchParser.dll" />
    </ItemGroup>
  </Target>
