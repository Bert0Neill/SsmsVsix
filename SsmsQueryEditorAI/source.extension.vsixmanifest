<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
    <Metadata>
        <Identity Id="SsmsAIBuddy_19_20.f79b07ee-abe6-4e30-bb4f-c6808f451d62" Version="1.0.3" Language="en-US" Publisher="Bert O'Neill" />
        <DisplayName>SsmsAIBuddy_19_20</DisplayName>
        <Description xml:space="preserve">SSMS AI Buddy extension. Targeting SSMS 19 &amp; 20

</Description>
        <License>Misc\Docs\LicenseAgreement.txt</License>
        <GettingStartedGuide>Misc\Docs\User Guide - SSMS AI Buddy.docx</GettingStartedGuide>
        <ReleaseNotes>Misc\Docs\SSMS AI Buddy Release Notes.txt</ReleaseNotes>
        <Icon>Iconshock-Real-Vista-Data-Database.256.png</Icon>
        <PreviewImage>SSMS_Preview.png</PreviewImage>
        <Tags>AI;SSMS AI;SSMS;SSMS Extension;Bert O'Neill;</Tags>
    </Metadata>
    <Installation>
        <!-- SSMS 18–20 (legacy 32-bit shell) -->
        <InstallationTarget Version="[17.0,18.0)" Id="Microsoft.VisualStudio.Community">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
        <!-- SSMS 21+ (64-bit VS shell) -->
    </Installation>
    <Dependencies>
        <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.7.2,)" />
    </Dependencies>
    <Prerequisites>
        <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" DisplayName="Visual Studio core editor" />
    </Prerequisites>
    <Assets>
        <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    </Assets>
</PackageManifest>
